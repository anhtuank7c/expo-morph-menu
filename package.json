{
  "name": "expo-morph-menu",
  "version": "0.1.0",
  "description": "A floating button that morphs into a menu, then into a full-screen expo-router route — and back. Bring-your-own-UI slots, Reanimated 4, iOS / Android / web.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "workspaces": [
    "example",
    "example-social"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example && tsc --noEmit -p example-social",
    "test:api": "node example-social/test/api.test.cjs",
    "prepack": "npm run clean && npm run build",
    "example": "cd example && expo start",
    "example:trace": "cd example && node scripts/start-trace.mjs",
    "e2e": "cd example && node scripts/e2e.mjs",
    "example:social": "cd example-social && expo start"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-router",
    "reanimated",
    "morph",
    "menu",
    "fab",
    "shared-element",
    "transition",
    "zoom-transition",
    "web",
    "headless",
    "slots"
  ],
  "author": "Tuan Nguyen",
  "license": "MIT",
  "peerDependencies": {
    "expo-blur": ">=58.0.0",
    "expo-glass-effect": ">=58.0.0",
    "expo-haptics": ">=58.0.0",
    "expo-router": ">=58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.80.0",
    "react-native-gesture-handler": ">=3.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-screens": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "expo-blur": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@reduxjs/toolkit": "^2.15.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.1",
    "typescript": "~6.0.3"
  }
}
