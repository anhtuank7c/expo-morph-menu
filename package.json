{
  "name": "expo-morph-menu",
  "version": "0.1.0",
  "description": "A floating button that morphs into a menu, then into a full-screen expo-router route — and back. Bring-your-own-UI slots, Reanimated 4, iOS / Android / web.",
  "homepage": "https://anhtuank7c.github.io/expo-morph-menu/",
  "bugs": {
    "url": "https://github.com/anhtuank7c/expo-morph-menu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhtuank7c/expo-morph-menu.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "workspaces": [
    "example",
    "example-social"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example && tsc --noEmit -p example-social",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:api": "node example-social/test/api.test.cjs",
    "prepack": "npm run clean && npm run build",
    "example": "cd example && expo start",
    "example:trace": "cd example && node scripts/start-trace.mjs",
    "e2e": "cd example && node scripts/e2e.mjs",
    "example:social": "cd example-social && expo start",
    "prepare": "husky"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-router",
    "reanimated",
    "morph",
    "menu",
    "fab",
    "shared-element",
    "transition",
    "zoom-transition",
    "web",
    "headless",
    "slots"
  ],
  "author": "Tuan Nguyen",
  "license": "MIT",
  "peerDependencies": {
    "expo-blur": ">=58.0.0",
    "expo-glass-effect": ">=58.0.0",
    "expo-haptics": ">=58.0.0",
    "expo-router": ">=58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.80.0",
    "react-native-gesture-handler": ">=3.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-screens": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "expo-blur": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@reduxjs/toolkit": "^2.15.0",
    "@types/react": "~19.3.3",
    "babel-preset-expo": "~58.0.27",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-glass-effect": "~58.0.6",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,yaml,yml,html,css}": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.1"
    }
  }
}
