        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="shell-c1" value="5 · Container full screen: các lớp và dòng thời gian" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="shell-c2" value="Một container đục đổi kích thước mỗi frame; mọi thứ bên trong cố định kích thước, chỉ mờ/hiện hoặc dịch chuyển. Navigator bên trong không bao giờ đo lại, nên vẫn là native stack thật." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="shell-c3" value="Backdrop (slot): opacity 0 → backdropOpacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c4" value="Container: rect animate, bo góc, overflow hidden, màu nền card → sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="78" y="190" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c5" value="Background (slot, &quot;sheet&quot;): mờ đi khi container lớn lên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="96" y="260" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c6" value="Nội dung cỡ cố định (Stack lồng của bạn): hiện dần, trượt từ −insets.top về 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="114" y="330" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c7" value="MenuFace: các dòng menu, neo góc card; mờ đi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="132" y="400" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c8" value="&lt;b&gt;Vì sao nội dung bị đẩy lên insets.top khi còn nhỏ:&lt;/b&gt; nội dung neo góc trên-trái của container; ở cỡ card phần lộ ra sẽ là dải status bar trống. Đẩy lên thì thứ lộ ra là header thật. Chỉ dùng transform, không tính lại layout." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="shell-c9" value="&lt;b&gt;tiến trình sheet&lt;/b&gt; (0 = card, 1 = full screen)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="640" height="24" as="geometry"/></mxCell>
        <mxCell id="shell-c10" value="0" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="40" height="20" as="geometry"/></mxCell>
