        <mxCell id="shell-c26" value="bóng" style="rounded=1;html=1;strokeColor=none;fontSize=10;fontColor=#ffffff;fillColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1260" y="440" width="60" height="34" as="geometry"/></mxCell>
        <mxCell id="shell-c27" value="" style="rounded=0;html=1;fillColor=#b85450;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="714" y="500" width="12" height="20" as="geometry"/></mxCell>
        <mxCell id="shell-c28" value="&lt;b&gt;0.005 = ARRIVED.&lt;/b&gt; Khi đóng, container giữ đục hoàn toàn tới khi trùng card (lệch &amp;lt; 1 dp), rồi card và container đổi chỗ trong một frame. Bóng đổ tắt khi bounds thay đổi mỗi frame, và tăng/giảm dần trong 10% ở mỗi đầu." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="720" y="530" width="640" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="slots" name="6 · Tuỳ biến UI (slot)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="750" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="slots-c1" value="6 · Tuỳ biến UI: phần bạn vẽ, phần package lái" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="slots-c2" value="expo-morph-menu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="slots-c3" value="Code của bạn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="64" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="slots-c4" value="Slot UI (của bạn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="360" y="64" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="slots-c5" value="Trạng thái chung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="64" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="slots-c6" value="&lt;b&gt;Card&lt;/b&gt; (package: kích thước · vị trí · bo góc · cắt nội dung · bóng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="700" height="600" as="geometry"/></mxCell>
        <mxCell id="slots-c7" value="Background: lấp đầy card; vẽ lại trên container khi đang morph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="660" height="540" as="geometry"/></mxCell>
        <mxCell id="slots-c8" value="Item #0: cao = itemHeight(item, 0)&lt;br&gt;props: item · index · variant · hovered · height · colors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="slots-c9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="100" y="284" width="580" height="10" as="geometry"/></mxCell>
        <mxCell id="slots-c10" value="Separator: layout.separatorHeight" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="294" width="620" height="20" as="geometry"/></mxCell>
        <mxCell id="slots-c11" value="Highlight (sau dòng đang hover) + Item #1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#fad7ac;" vertex="1" parent="1"><mxGeometry x="80" y="318" width="620" height="56" as="geometry"/></mxCell>
        <mxCell id="slots-c12" value="Item #2 …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="slots-c13" value="Trigger&lt;br&gt;(mặt nút +)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="600" width="90" height="80" as="geometry"/></mxCell>
        <mxCell id="slots-c14" value="Vị trí và chiều cao dòng được tính trước (không đo), dùng cho hit testing khi kéo để chọn và cho highlight." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="500" height="80" as="geometry"/></mxCell>
        <mxCell id="slots-c15" value="&lt;b&gt;Hợp đồng của slot&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Thuần.&lt;/b&gt; Item và Background được vẽ hai lần (card + container). Cùng props → cùng pixel, nếu không sẽ thấy hai bản chồng lên nhau lúc chuyển giao. Không state riêng, không animation nhấn/xuất hiện riêng.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Không tự animate kích thước, vị trí&lt;/b&gt; trong slot. Đọc progress / hovered (SharedValue) để animate opacity, màu, xoay.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Chiều cao biết trước:&lt;/b&gt; layout.rowHeight hoặc itemHeight() thuần.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Background đục:&lt;/b&gt; card và container đổi chỗ trong một frame." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="580" height="330" as="geometry"/></mxCell>
        <mxCell id="slots-c16" value="&lt;b&gt;Bên ngoài card&lt;/b&gt;&lt;br&gt;&lt;br&gt;Scrim: sau menu đang mở (opacity đã được animate; chạm để đóng)&lt;br&gt;Backdrop: sau full screen&lt;br&gt;MorphCloseButton: trong màn của bạn; icon qua closeIcon / icon&lt;br&gt;fabIcon · item.icon: mọi MorphIcon: element, ảnh hoặc ({ size, color }) =&amp;gt; node&lt;br&gt;&lt;br&gt;Ngoài slot: useMorphProgress() → { menu, sheet } để điều khiển animation của riêng bạn." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="580" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
