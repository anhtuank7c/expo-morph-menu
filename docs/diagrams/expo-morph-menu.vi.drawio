        <mxCell id="close-c16" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp; nút đóng · nút back phần cứng · back trình duyệt · Esc · vuốt cạnh / kéo xuống" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="161" y="156" width="560" height="32" as="geometry"/></mxCell>
