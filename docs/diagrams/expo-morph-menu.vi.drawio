        <mxCell id="close-c24" value="&lt;b&gt;5&lt;/b&gt;&amp;nbsp; frame có sheet ≤ 0.005: hoán đổi, container opacity 0, card opacity 1 (cùng một frame UI)" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="836" y="364" width="560" height="32" as="geometry"/></mxCell>
