        <mxCell id="shell-c24" value="nội dung translateY −insets.top → 0" style="rounded=1;html=1;strokeColor=none;fontSize=10;fontColor=#ffffff;fillColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="388" width="600" height="34" as="geometry"/></mxCell>
