        <mxCell id="close-c2" value="Mọi đường đóng gặp nhau ở usePreventRemove, nên morph ngược chỉ nằm ở một chỗ. Chuyển giao về card là một lần hoán đổi trong một frame, không phải crossfade." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1250" height="40" as="geometry"/></mxCell>
