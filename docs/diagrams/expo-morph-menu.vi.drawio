        <mxCell id="close-c32" value="&lt;b&gt;9&lt;/b&gt;&amp;nbsp; repeat() → hành động gốc chạy tiếp, route bị pop" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="386" y="572" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-c33" value="&lt;b&gt;handoff giữ RETURNING kể cả sau unmount.&lt;/b&gt; Android (react-native-screens) gỡ view native bất đồng bộ; đặt lại handoff lúc unmount sẽ làm container cũ hiện lại một frame. Lần chọn kế tiếp mới đặt lại MENU." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="668" width="640" height="110" as="geometry"/></mxCell>
        <mxCell id="close-c34" value="&lt;b&gt;Web:&lt;/b&gt; usePreventRemove còn chặn cả việc rời trang (&quot;Leave site?&quot;) suốt lúc full screen mở. Package tắt phần đó khi có beforeunload (listener đăng ký trong useLayoutEffect để chạy trước listener của React Navigation)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="720" y="668" width="640" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
