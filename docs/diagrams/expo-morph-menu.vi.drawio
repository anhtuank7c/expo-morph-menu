        <mxCell id="states-c9" value="route đã layout&lt;br&gt;(onLayout · web: useLayoutEffect)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="255" y="120" width="190" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c10" value="đóng&lt;br&gt;(usePreventRemove)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="260" width="170" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c11" value="lần chọn kế tiếp&lt;br&gt;(hoặc mount qua deep link)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="190" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c12" value="&lt;b&gt;Cái gì đang hiện&lt;/b&gt; (Android / web: card overlay nằm trên route)&lt;br&gt;&lt;br&gt;MENU: card 1 · container 1 (container mount bên dưới, giống hệt)&lt;br&gt;ROUTE: card 0 · container 1&lt;br&gt;RETURNING, sheet &amp;gt; 0.005: card 0 · container 1&lt;br&gt;RETURNING, sheet ≤ 0.005: card 1 · container 0 ← hoán đổi&lt;br&gt;&lt;br&gt;&lt;b&gt;iOS:&lt;/b&gt; transparentModal được present đè lên overlay, nên card luôn ở opacity 1 (không bao giờ animate opacity trên view kính/blur)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="600" height="240" as="geometry"/></mxCell>
