        <mxCell id="open-c40" value="&lt;b&gt;13&lt;/b&gt;&amp;nbsp; spring xong → useMorphSettled() = true: mount phần nặng" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="840" y="756" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="open-c41" value="&lt;b&gt;Bước 10, native và web:&lt;/b&gt; native chờ onLayout của container (view native có thể chưa lên màn khi effect chạy). Web chuyển giao trong useLayoutEffect vì DOM được vẽ trong cùng frame, còn onLayout (ResizeObserver) về trễ vài frame và để card đè lên container đang mở rộng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1300" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
