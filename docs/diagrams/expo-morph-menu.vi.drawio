        <mxCell id="open-a37" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="740" as="sourcePoint"/><mxPoint x="605" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="open-c38" value="&lt;b&gt;12&lt;/b&gt;&amp;nbsp; sheet = spring(1): container lớn dần · nội dung hiện · mặt menu mờ đi" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="611" y="706" width="560" height="32" as="geometry"/></mxCell>
