        <mxCell id="states-e21" value="" style="endArrow=block;endFill=1;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="states-c16" target="states-c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-c22" value="nhấn nút +" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="945" y="108" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="states-c23" value="scrim · back · Esc · thả tay ngoài card" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="925" y="205" width="240" height="34" as="geometry"/></mxCell>
        <mxCell id="states-c24" value="chọn một dòng" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1075" y="258" width="110" height="34" as="geometry"/></mxCell>
        <mxCell id="states-c25" value="đã đóng,&lt;br&gt;closeMenuOnDismiss = false" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1150" y="360" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c26" value="đã đóng,&lt;br&gt;closeMenuOnDismiss = true" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="730" y="270" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c27" value="&lt;b&gt;Ai nhận chạm&lt;/b&gt;&lt;br&gt;&lt;br&gt;closed: chỉ vùng bấm của nút +&lt;br&gt;open: scrim + các dòng; nút back phần cứng / Esc đóng menu&lt;br&gt;route: overlay không nhận chạm và không xử lý back. Nếu không (Android và web, overlay ở trên) scrim sẽ chặn chạm vào nút đóng&lt;br&gt;&lt;br&gt;&lt;b&gt;pressing&lt;/b&gt;: khi cú nhấn bắt đầu trên nút + còn giữ, vùng bấm vẫn hoạt động dù đã &quot;open&quot;: trên web, phần tử pointer-events:none không nhận pointerup và gesture sẽ kẹt." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="740" y="450" width="600" height="240" as="geometry"/></mxCell>
