  <diagram id="page-2" name="2 · Vòng đời morph">
    <mxGraphModel dx="1200" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h" value="Vòng đời một lần mở — ai đổi giá trị nào, ở đâu" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="640" height="30" as="geometry"/></mxCell>

        <mxCell id="s1" value="1 · Chạm hoặc giữ nút “+”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="a1" value="onBegin → menu: 0 → 1 (spring, UI thread)" style="text;html=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="410" y="98" width="400" height="24" as="geometry"/></mxCell>

        <mxCell id="s2" value="2 · Rê ngón tay qua các dòng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="a2" value="hit-test trong worklet → hovered = i&#10;haptic + PREFETCH dữ liệu (sớm 150–400ms)" style="text;html=1;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="420" height="40" as="geometry"/></mxCell>

        <mxCell id="s3" value="3 · Nhả tay trên một dòng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="a3" value="origin ← rect của card&#10;router.push('/(sheet)/[key]')" style="text;html=1;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="230" width="420" height="40" as="geometry"/></mxCell>

        <mxCell id="s4" value="4 · Route mount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="a4" value="sheet: 0 → 1 từ origin rect&#10;onLayout → handoff = 1 → overlay tắt đúng frame route có mặt" style="text;html=1;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="440" height="40" as="geometry"/></mxCell>

        <mxCell id="s5" value="5 · Spring kết thúc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="80" y="370" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="a5" value="settled = true → mới mount nội dung nặng (trước đó là skeleton)&#10;shadow bật lại" style="text;html=1;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="370" width="440" height="40" as="geometry"/></mxCell>

        <mxCell id="s6" value="6 · Push màn con bên trong" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="a6" value="native-stack lo hết. Vỏ đứng yên, không animate gì.&#10;Swipe-back iOS và back cứng Android là của hệ điều hành." style="text;html=1;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="440" width="460" height="40" as="geometry"/></mxCell>

        <mxCell id="s7" value="7 · Thoát: ×, back cứng, router.back(), kéo xuống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="300" height="52" as="geometry"/></mxCell>
        <mxCell id="a7" value="usePreventRemove CHẶN việc gỡ route&#10;sheet: 1 → 0  ·  xong spring mới tắt cờ chặn và gọi repeat()&#10;handoff = 0 → overlay nhận lại card → menu: 1 → 0" style="text;html=1;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="505" width="470" height="60" as="geometry"/></mxCell>

        <mxCell id="ee1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note2" value="Chỉ có MỘT chỗ lo việc đảo chiều morph (bước 7).&lt;br&gt;Mọi đường thoát đều chảy qua usePreventRemove, nên&lt;br&gt;không có đường nào làm route biến mất đột ngột.&lt;br&gt;&lt;br&gt;Cử chỉ kéo xuống gọi thẳng goBack(): spring chạy tiếp&lt;br&gt;từ giá trị hiện tại của sheet, không giật nối." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="420" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

