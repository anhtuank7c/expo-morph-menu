        <mxCell id="e9" value="menu · origin · handoff" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;strokeColor=#82b366;fontSize=10;startArrow=classic;" edge="1" parent="1" source="prov" target="ovl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="sheet · origin · handoff" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;strokeColor=#82b366;fontSize=10;startArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="prov" target="shell"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note1" value="Overlay và route KHÔNG biết nhau.&lt;br&gt;Chúng chỉ chia sẻ hình học qua origin.&lt;br&gt;&lt;br&gt;Hệ quả: deep link thẳng vào route vẫn&lt;br&gt;chạy — khi đó origin rỗng nên vỏ nở&lt;br&gt;nhẹ từ giữa màn." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="280" height="120" as="geometry"/></mxCell>
