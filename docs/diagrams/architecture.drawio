        <mxCell id="l2d" value="Chạy độc lập với JS, nhưng vẫn là một&#10;luồng TRONG app: mỗi frame cập nhật&#10;props qua shadow tree." style="text;html=1;fontSize=10;fontColor=#6a4a8a;whiteSpace=wrap;" vertex="1" parent="l2"><mxGeometry x="20" y="200" width="290" height="60" as="geometry"/></mxCell>

        <mxCell id="l3" value="Hệ điều hành — ngoài tầm với của app" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="330" height="330" as="geometry"/></mxCell>
        <mxCell id="l3a" value="push/pop của native-stack" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="l3"><mxGeometry x="20" y="50" width="290" height="36" as="geometry"/></mxCell>
        <mxCell id="l3b" value="swipe-back của iOS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="l3"><mxGeometry x="20" y="98" width="290" height="36" as="geometry"/></mxCell>
        <mxCell id="l3c" value="nội suy Core Animation (render server)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="l3"><mxGeometry x="20" y="146" width="290" height="36" as="geometry"/></mxCell>
        <mxCell id="l3d" value="Không đi qua JS, cũng không qua&#10;Reanimated. Đây chính là code của&#10;Apple/Google — không phải mô phỏng." style="text;html=1;fontSize=10;fontColor=#4a7a3a;whiteSpace=wrap;" vertex="1" parent="l3"><mxGeometry x="20" y="200" width="290" height="60" as="geometry"/></mxCell>

        <mxCell id="note4" value="Kết luận thực dụng: cú push của native-stack chạy đúng đoạn code hệ thống mà app Swift/Kotlin dùng.&lt;br&gt;Overlay “mượt hơn” không phải vì animation rẻ hơn, mà vì nó không phải mount gì cả.&lt;br&gt;Khi bạn mount cùng một nội dung vào overlay, chi phí y hệt. Biến số thật luôn là cột bên trái." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="1040" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
