        <mxCell id="l2b" value="hit-test ngón tay → chỉ số dòng" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="l2"><mxGeometry x="20" y="98" width="290" height="36" as="geometry"/></mxCell>
