        <mxCell id="h4s" value="Hiểu bảng này là hiểu vì sao overlay không hề “rẻ hơn” native-stack." style="text;html=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="55" width="700" height="24" as="geometry"/></mxCell>

