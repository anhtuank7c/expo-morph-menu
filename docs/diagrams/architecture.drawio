  <diagram id="page-1" name="1 · Ranh giới route">
    <mxGraphModel dx="1200" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="Ranh giới: cái gì là route, cái gì không" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="t2" value="Menu đang mở không phải điểm đến — không ai deep link vào nó. Màn full-screen thì có." style="text;html=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="58" width="700" height="24" as="geometry"/></mxCell>

        <mxCell id="prov" value="&lt;b&gt;MorphProvider&lt;/b&gt;&lt;br&gt;&lt;br&gt;menu&amp;nbsp;&amp;nbsp;&amp;nbsp;0→1&amp;nbsp; FAB nở thành card&lt;br&gt;sheet&amp;nbsp;&amp;nbsp;0→1&amp;nbsp; card nở full-screen&lt;br&gt;origin&amp;nbsp;rect&amp;nbsp; card ở đâu lúc push&lt;br&gt;handoff 0|1&amp;nbsp; route đã layout chưa" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="250" height="140" as="geometry"/></mxCell>

        <mxCell id="ovl" value="&lt;b&gt;MorphingMenu&lt;/b&gt;&lt;br&gt;overlay — KHÔNG phải route&lt;br&gt;&lt;br&gt;render song song với &amp;lt;Stack&amp;gt;&lt;br&gt;nuốt back cứng Android" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="250" height="110" as="geometry"/></mxCell>

        <mxCell id="root" value="&lt;b&gt;app/_layout.tsx&lt;/b&gt;&amp;nbsp;&amp;nbsp;Stack gốc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="300" height="50" as="geometry"/></mxCell>

        <mxCell id="idx" value="index.tsx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="150" height="45" as="geometry"/></mxCell>

        <mxCell id="grp" value="&lt;b&gt;(sheet)&lt;/b&gt;&amp;nbsp; presentation: transparentModal&lt;br&gt;animation: none&amp;nbsp;·&amp;nbsp; gestureEnabled: false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="225" width="310" height="55" as="geometry"/></mxCell>

        <mxCell id="shell" value="&lt;b&gt;(sheet)/_layout.tsx&lt;/b&gt;&amp;nbsp;&amp;nbsp;VỎ MORPH&lt;br&gt;Animated.View — width/height đổi mỗi frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="310" height="55" as="geometry"/></mxCell>

