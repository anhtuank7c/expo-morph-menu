        <mxCell id="l1e" value="⚠ Đây là nơi sinh ra độ trễ người dùng&#10;thấy được: mount màn đích." style="text;html=1;fontSize=10;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="l1"><mxGeometry x="20" y="248" width="290" height="50" as="geometry"/></mxCell>

