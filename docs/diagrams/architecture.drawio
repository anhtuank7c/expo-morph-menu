        <mxCell id="goodnote" value="Chỉ node vỏ phải đo lại. Ruột giữ nguyên W × H và chỉ bị overflow:hidden cắt,&#10;nên cây con không bao giờ dirty → push/pop màn con vẫn là native-stack thật." style="text;html=1;fontSize=11;fontColor=#4a7a3a;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="675" width="620" height="40" as="geometry"/></mxCell>

        <mxCell id="note3" value="Vùng tô = cái bị đo lại mỗi frame.&lt;br&gt;Viền đứt bên phải = phần bị cắt khỏi màn hình,&lt;br&gt;vẫn tồn tại nhưng không tốn layout.&lt;br&gt;&lt;br&gt;Ba khung là ba thời điểm: morph ≈ 0, 0.5, 1." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="690" y="120" width="300" height="110" as="geometry"/></mxCell>
