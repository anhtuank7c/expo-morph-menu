        <mxCell id="open-a39" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="790" as="sourcePoint"/><mxPoint x="1280" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="open-c40" value="&lt;b&gt;13&lt;/b&gt;&amp;nbsp; spring finished → useMorphSettled() = true: mount heavy content" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="840" y="756" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="open-c41" value="&lt;b&gt;Step 10, native vs web:&lt;/b&gt; native waits for the container's onLayout (the native view may not be on screen yet when effects run). Web hands off in useLayoutEffect, because the DOM is painted in the same frame, while onLayout (ResizeObserver) arrives frames later and would leave the card covering the growing container." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1300" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="close" name="3 · Closing">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="808" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="close-c1" value="3 · Closing: full screen → back into the menu" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="close-c2" value="All dismiss paths converge on usePreventRemove, so the reverse morph lives in exactly one place. The hand-off back to the card is a single-frame swap, not a crossfade." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1250" height="40" as="geometry"/></mxCell>
        <mxCell id="close-c3" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="close-a4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="155" y="160" as="sourcePoint"/><mxPoint x="155" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c5" value="expo-router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="285" y="110" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="close-a6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="160" as="sourcePoint"/><mxPoint x="380" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c7" value="MorphSheetLayout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="close-a8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="160" as="sourcePoint"/><mxPoint x="605" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c9" value="Shared values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="735" y="110" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="close-a10" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="160" as="sourcePoint"/><mxPoint x="830" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c11" value="MorphMenu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="close-a12" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="160" as="sourcePoint"/><mxPoint x="1055" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c13" value="Your callbacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1185" y="110" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="close-a14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="160" as="sourcePoint"/><mxPoint x="1280" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-a15" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="155" y="190" as="sourcePoint"/><mxPoint x="380" y="190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c16" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp; close button · Android back · browser back · Esc · edge swipe / drag" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="161" y="156" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-a17" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="242" as="sourcePoint"/><mxPoint x="605" y="242" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c18" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp; removal blocked → usePreventRemove callback(repeat)" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="386" y="208" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-a19" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="294" as="sourcePoint"/><mxPoint x="830" y="294" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c20" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp; handoff = RETURNING · sheet = spring(0): continues from the gesture value" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="611" y="260" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-a21" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="346" as="sourcePoint"/><mxPoint x="830" y="346" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c22" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp; container shrinks · content fades out · MenuFace fades in" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="611" y="312" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-a23" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="398" as="sourcePoint"/><mxPoint x="1055" y="398" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c24" value="&lt;b&gt;5&lt;/b&gt;&amp;nbsp; frame where sheet ≤ 0.005: swap, container opacity 0, card opacity 1 (same UI frame)" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="836" y="364" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-a25" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="450" as="sourcePoint"/><mxPoint x="830" y="450" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c26" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp; closeMenuOnDismiss = false: scrim back, menu stays open · true: menu = spring(0) → button" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="836" y="416" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-a27" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="502" as="sourcePoint"/><mxPoint x="1055" y="502" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c28" value="&lt;b&gt;7&lt;/b&gt;&amp;nbsp; spring finished → allowLeave → sheetDismissed(): mode = open | closed" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="611" y="468" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-a29" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="554" as="sourcePoint"/><mxPoint x="1280" y="554" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c30" value="&lt;b&gt;8&lt;/b&gt;&amp;nbsp; onSheetDismissed(item)" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="611" y="520" width="663" height="32" as="geometry"/></mxCell>
        <mxCell id="close-a31" value="" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="606" as="sourcePoint"/><mxPoint x="380" y="606" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="close-c32" value="&lt;b&gt;9&lt;/b&gt;&amp;nbsp; repeat() → the original action continues, route popped" style="text;html=1;fontSize=11;align=left;verticalAlign=bottom;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="386" y="572" width="560" height="32" as="geometry"/></mxCell>
        <mxCell id="close-c33" value="&lt;b&gt;handoff stays RETURNING after unmount.&lt;/b&gt; Android (react-native-screens) removes native views asynchronously; resetting handoff on unmount would show the old container again for a frame. The next selection resets it to MENU." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="668" width="640" height="110" as="geometry"/></mxCell>
        <mxCell id="close-c34" value="&lt;b&gt;Web:&lt;/b&gt; usePreventRemove would also block page unload (&quot;Leave site?&quot;) while the full screen is open. The package disables that on beforeunload (listener registered in useLayoutEffect so it runs before React Navigation's)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="720" y="668" width="640" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="states" name="4 · State machines">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="740" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="states-c1" value="4 · State machines" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="states-c2" value="&lt;b&gt;handoff&lt;/b&gt;: who shows the card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="640" height="640" as="geometry"/></mxCell>
        <mxCell id="states-c3" value="MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="states-c4" value="ROUTE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="states-c5" value="RETURNING" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="275" y="340" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="states-e6" value="" style="endArrow=block;endFill=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="states-c3" target="states-c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-e7" value="" style="endArrow=block;endFill=1;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="states-c4" target="states-c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-e8" value="" style="endArrow=block;endFill=1;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="states-c5" target="states-c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-c9" value="route laid out&lt;br&gt;(onLayout · web: useLayoutEffect)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="255" y="120" width="190" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c10" value="dismiss&lt;br&gt;(usePreventRemove)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="260" width="170" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c11" value="next selection&lt;br&gt;(or deep link mount)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="190" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c12" value="&lt;b&gt;What is visible&lt;/b&gt; (Android / web: the card overlay is above the route)&lt;br&gt;&lt;br&gt;MENU: card 1 · container 1 (container mounts underneath, identical)&lt;br&gt;ROUTE: card 0 · container 1&lt;br&gt;RETURNING, sheet &amp;gt; 0.005: card 0 · container 1&lt;br&gt;RETURNING, sheet ≤ 0.005: card 1 · container 0 ← swap&lt;br&gt;&lt;br&gt;&lt;b&gt;iOS:&lt;/b&gt; the transparentModal is presented above the overlay, so the card always stays at opacity 1 (never animate opacity on glass/blur views)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="600" height="240" as="geometry"/></mxCell>
        <mxCell id="states-c13" value="&lt;b&gt;MorphMenu mode&lt;/b&gt;: who receives touches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="640" height="640" as="geometry"/></mxCell>
        <mxCell id="states-c14" value="closed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="states-c15" value="open" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="140" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="states-c16" value="route" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="340" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="states-e17" value="" style="endArrow=block;endFill=1;html=1;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="states-c14" target="states-c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-e18" value="" style="endArrow=block;endFill=1;html=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="states-c15" target="states-c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-e19" value="" style="endArrow=block;endFill=1;html=1;exitX=0.25;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="states-c15" target="states-c16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-e20" value="" style="endArrow=block;endFill=1;html=1;exitX=1;exitY=0.75;entryX=0.75;entryY=1;" edge="1" parent="1" source="states-c16" target="states-c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-e21" value="" style="endArrow=block;endFill=1;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="states-c16" target="states-c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="states-c22" value="press the button" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="945" y="108" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="states-c23" value="scrim · back · Esc · drag released outside" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="925" y="205" width="240" height="34" as="geometry"/></mxCell>
        <mxCell id="states-c24" value="select a row" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1075" y="258" width="110" height="34" as="geometry"/></mxCell>
        <mxCell id="states-c25" value="dismissed,&lt;br&gt;closeMenuOnDismiss = false" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1150" y="360" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c26" value="dismissed,&lt;br&gt;closeMenuOnDismiss = true" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="730" y="270" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="states-c27" value="&lt;b&gt;Touch ownership&lt;/b&gt;&lt;br&gt;&lt;br&gt;closed: only the button hit area&lt;br&gt;open: scrim + rows; Android back / Esc close the menu&lt;br&gt;route: the overlay receives no touches and does not handle back. Otherwise (Android and web, overlay on top) the scrim would intercept taps on the close button&lt;br&gt;&lt;br&gt;&lt;b&gt;pressing&lt;/b&gt;: while a press that started on the button is down, its hit area stays active even in &quot;open&quot;: on web, a pointer-events:none element never receives pointerup and the gesture would get stuck." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="740" y="450" width="600" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="shell" name="5 · Container: layers and timeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="640" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="shell-c1" value="5 · The full-screen container: layers and timeline" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="shell-c2" value="One opaque container changes size every frame; everything inside it is fixed-size and only fades or translates. The inner navigator never re-lays out, so it stays a real native stack." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="shell-c3" value="Backdrop (slot): opacity 0 → backdropOpacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c4" value="Container: animated rect, corner radius, overflow hidden, background color card → sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="78" y="190" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c5" value="Background (slot, &quot;sheet&quot;): fades out as the container grows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="96" y="260" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c6" value="Fixed W × H content (your inner Stack): fades in, slides from −insets.top to 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="114" y="330" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c7" value="MenuFace: the menu rows, anchored to the card corner; fades out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="132" y="400" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="shell-c8" value="&lt;b&gt;Why the content is pushed up by insets.top while small:&lt;/b&gt; the content is anchored to the container's top-left; at card size the visible part would be the empty status-bar strip. Shifting it up shows the real header instead. Transform only, no layout pass." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="shell-c9" value="&lt;b&gt;sheet progress&lt;/b&gt; (0 = card, 1 = full screen)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="640" height="24" as="geometry"/></mxCell>
