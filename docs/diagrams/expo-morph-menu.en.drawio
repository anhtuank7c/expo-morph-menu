        <mxCell id="shell-c24" value="content translateY −insets.top → 0" style="rounded=1;html=1;strokeColor=none;fontSize=10;fontColor=#ffffff;fillColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="388" width="600" height="34" as="geometry"/></mxCell>
        <mxCell id="shell-c25" value="shadow" style="rounded=1;html=1;strokeColor=none;fontSize=10;fontColor=#ffffff;fillColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="60" height="34" as="geometry"/></mxCell>
        <mxCell id="shell-c26" value="shadow" style="rounded=1;html=1;strokeColor=none;fontSize=10;fontColor=#ffffff;fillColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1260" y="440" width="60" height="34" as="geometry"/></mxCell>
        <mxCell id="shell-c27" value="" style="rounded=0;html=1;fillColor=#b85450;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="714" y="500" width="12" height="20" as="geometry"/></mxCell>
        <mxCell id="shell-c28" value="&lt;b&gt;0.005 = ARRIVED.&lt;/b&gt; When closing, the container stays fully opaque until it matches the card (&amp;lt; 1 dp off), then card and container swap in one frame. Shadows are disabled while the bounds change every frame, and fade over 10% at each end." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="720" y="530" width="640" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="slots" name="6 · Custom UI (slots)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="750" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="slots-c1" value="6 · Custom UI: what you draw, what the package moves" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="slots-c2" value="expo-morph-menu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="slots-c3" value="Your code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="64" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="slots-c4" value="UI slot (yours)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="360" y="64" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="slots-c5" value="Shared state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="64" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="slots-c6" value="&lt;b&gt;Card&lt;/b&gt; (package: size · position · corners · clipping · shadow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="700" height="600" as="geometry"/></mxCell>
        <mxCell id="slots-c7" value="Background: fills the card; drawn again on the container while morphing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="660" height="540" as="geometry"/></mxCell>
        <mxCell id="slots-c8" value="Item #0: height = itemHeight(item, 0)&lt;br&gt;props: item · index · variant · hovered · height · colors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="slots-c9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="100" y="284" width="580" height="10" as="geometry"/></mxCell>
        <mxCell id="slots-c10" value="Separator: layout.separatorHeight" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="294" width="620" height="20" as="geometry"/></mxCell>
        <mxCell id="slots-c11" value="Highlight (behind the hovered row) + Item #1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#fad7ac;" vertex="1" parent="1"><mxGeometry x="80" y="318" width="620" height="56" as="geometry"/></mxCell>
        <mxCell id="slots-c12" value="Item #2 …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="slots-c13" value="Trigger&lt;br&gt;(button face)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="600" width="90" height="80" as="geometry"/></mxCell>
        <mxCell id="slots-c14" value="Row offsets and heights are computed in advance (not measured). They are used for drag-to-select hit testing and the highlight." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="500" height="80" as="geometry"/></mxCell>
        <mxCell id="slots-c15" value="&lt;b&gt;The slot contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Pure.&lt;/b&gt; Item and Background render twice (card + container). Same props → same pixels, or two overlapping copies show at hand-off. No internal state, no enter/press animations of their own.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Don't animate size or position&lt;/b&gt; inside a slot. Read progress / hovered (SharedValues) for opacity, color, rotation.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Known heights:&lt;/b&gt; layout.rowHeight or a pure itemHeight().&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Opaque Background:&lt;/b&gt; card and container swap in one frame." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="580" height="330" as="geometry"/></mxCell>
        <mxCell id="slots-c16" value="&lt;b&gt;Outside the card&lt;/b&gt;&lt;br&gt;&lt;br&gt;Scrim: behind the open menu (opacity animated for you; tap closes)&lt;br&gt;Backdrop: behind the full screen&lt;br&gt;MorphCloseButton: in your screens; icon via closeIcon / icon&lt;br&gt;fabIcon · item.icon: any MorphIcon: element, image source or ({ size, color }) =&amp;gt; node&lt;br&gt;&lt;br&gt;Beyond slots: useMorphProgress() → { menu, sheet } for your own animations." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="580" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
