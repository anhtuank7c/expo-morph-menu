---
/**
 * A live demo: the example app's screen at `route`, running in a phone frame
 * (the example app's web build, served next to the site under /playground),
 * with whatever the page puts in the slot on the right ("How it works").
 */
interface Props {
  /** Route inside the app: `''` for its home, `'?variant=custom'`, `'compose/poll'`. */
  route: string;
  /** `example` (the basic app, /playground) or `social` (the social app, /playground-social). */
  app?: 'example' | 'social';
  /** Short line under the phone. */
  caption?: string;
}
const { route, app = 'example', caption } = Astro.props;
const vi = Astro.currentLocale === 'vi';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const folder = app === 'social' ? 'playground-social' : 'playground';
const playground = `${base}/${folder}`;
// `compose/poll` → `/playground-social/compose/poll/`, `?variant=custom` → `/playground/?variant=custom`
// (each screen is a folder: GitHub Pages would redirect without the slash).
const [screen, query] = route.replace(/^\//, '').split('?');
const src = `${playground}/${screen ? `${screen}/` : ''}${query ? `?${query}` : ''}`;
const hint = caption ?? (vi ? 'Demo chạy thật. Bấm nút + thử.' : 'Live demo. Tap the + button.');
---

<div class="demo">
  <figure class="phone-wrap not-content">
    <div class="phone">
      <div class="screen">
        <iframe src={src} title={hint} loading="lazy" allow="autoplay"></iframe>
      </div>
    </div>
    <figcaption>
      {hint}
      <a href={src} target="_blank" rel="noopener">{vi ? 'Mở toàn màn hình ↗' : 'Open full screen ↗'}</a>
    </figcaption>
  </figure>
  <div class="side"><slot /></div>
</div>

<style>
  .demo {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }
  .phone-wrap {
    margin: 0;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  /* The screen is a 390 × 844 device scaled to fit. */
  .phone {
    --scale: 0.74;
    width: calc(390px * var(--scale) + 20px);
    height: calc(844px * var(--scale) + 20px);
    padding: 10px;
    border-radius: 46px;
    background: #111;
    box-shadow:
      0 0 0 2px #2a2a2e,
      0 24px 48px -12px rgb(0 0 0 / 0.45);
  }
  .screen {
    width: calc(390px * var(--scale));
    height: calc(844px * var(--scale));
    border-radius: 36px;
    overflow: hidden;
    background: #f2f2f7;
  }
  iframe {
    width: 390px;
    height: 844px;
    border: 0;
    transform: scale(var(--scale));
    transform-origin: 0 0;
  }
  figcaption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    display: flex;
    gap: 0.75rem;
  }
  .side {
    flex: 1 1 18rem;
    min-width: 0;
  }
  @media (max-width: 30rem) {
    .phone {
      --scale: 0.66;
    }
  }
</style>
